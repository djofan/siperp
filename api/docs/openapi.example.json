{
  "openapi": "3.1.0",
  "info": {
    "title": "Siperp REST example (test only)",
    "version": "1.0.0",
    "description": "Non-production reference. Routes are registered only by tests; in-memory idempotency does not provide cross-process durability."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sanctum personal access token; absolute lifetime seven days. No session cookies."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "degraded"
                ]
              },
              "database": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "connected",
                      "unavailable"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "status",
              "database"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "PaymentAttempt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[a-z0-9]{24}$"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "pending",
              "cancelled"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "amount",
          "status"
        ],
        "additionalProperties": false
      },
      "PaymentAttemptResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PaymentAttempt"
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "PaymentAttemptCollection": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentAttempt"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer",
                "maximum": 100
              },
              "total": {
                "type": "integer"
              },
              "last_page": {
                "type": "integer"
              },
              "from": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "to": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "path": {
                "type": "string"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "active": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "url",
                    "label",
                    "active"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "current_page",
              "per_page",
              "total",
              "last_page",
              "from",
              "to",
              "path",
              "links"
            ],
            "additionalProperties": true
          },
          "links": {
            "type": "object",
            "properties": {
              "first": {
                "type": "string"
              },
              "last": {
                "type": "string"
              },
              "prev": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "first",
              "last",
              "prev",
              "next"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data",
          "meta",
          "links"
        ],
        "additionalProperties": false
      }
    }
  },
  "x-example-only": true,

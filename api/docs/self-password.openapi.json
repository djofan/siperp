{
  "openapi": "3.1.0",
  "info": {
    "title": "Self-service password",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/password": {
      "put": {
        "summary": "Change own account password",
        "description": "Authenticated active account only. Current password required; new password 12\u2013128 characters and different. Confirmation must match. Revokes other API tokens. Five attempts per minute. No target user accepted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "current_password",
                  "password",
                  "password_confirmation"
                ],
                "properties": {
                  "current_password": {
                    "type": "string",
                    "writeOnly": true
                  },
                  "password": {
                    "type": "string",
                    "writeOnly": true
                  },
                  "password_confirmation": {
                    "type": "string",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated; data.message"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "422": {
            "description": "Invalid password"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  }
}

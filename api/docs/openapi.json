{
  "openapi": "3.1.0",
  "info": {
    "title": "Siperp API",
    "version": "1.0.0",
    "description": "Partial API contract. Includes Core foundation and Academy participant registration; other runtime endpoints are defined by their module routes and tests."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sanctum personal access token; absolute lifetime seven days. No session cookies."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "degraded"
                ]
              },
              "database": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "connected",
                      "unavailable"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "status",
              "database"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "PaymentAttempt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[a-z0-9]{24}$"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "pending",
              "cancelled"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "amount",
          "status"
        ],
        "additionalProperties": false
      },
      "PaymentAttemptResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PaymentAttempt"
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "PaymentAttemptCollection": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentAttempt"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer",
                "maximum": 100
              },
              "total": {
                "type": "integer"
              },
              "last_page": {
                "type": "integer"
              },
              "from": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "to": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "path": {
                "type": "string"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "active": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "url",
                    "label",
                    "active"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "current_page",
              "per_page",
              "total",
              "last_page",
              "from",
              "to",
              "path",
              "links"
            ],
            "additionalProperties": true
          },
          "links": {
            "type": "object",
            "properties": {
              "first": {
                "type": "string"
              },
              "last": {
                "type": "string"
              },
              "prev": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "first",
              "last",
              "prev",
              "next"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data",
          "meta",
          "links"
        ],
        "additionalProperties": false
      },
      "AcademyParticipantCreate": {
        "type": "object",
        "required": [
          "name",
          "address",
          "phone",
          "password",
          "gender",
          "cohortId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "maxLength": 2000
          },
          "phone": {
            "type": "string",
            "description": "Indonesian mobile number; local 08 prefix is normalized to 628."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "writeOnly": true,
            "description": "Maximum 72 bytes."
          },
          "gender": {
            "type": "string",
            "enum": [
              "IKHWAN",
              "AKHWAT"
            ]
          },
          "cohortId": {
            "type": "string",
            "description": "Existing cohort ID; required for admin creation."
          },
          "courseId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional existing course; if cohort-bound it must belong to the chosen cohort."
          }
        }
      },
      "AcademyPublicRegistration": {
        "type": "object",
        "required": [
          "name",
          "address",
          "phone",
          "password",
          "gender",
          "email",
          "confirmPassword"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "maxLength": 2000
          },
          "phone": {
            "type": "string",
            "description": "Indonesian mobile number; local 08 prefix is normalized to 628."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "writeOnly": true,
            "description": "Maximum 72 bytes."
          },
          "gender": {
            "type": "string",
            "enum": [
              "IKHWAN",
              "AKHWAT"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 191
          },
          "confirmPassword": {
            "type": "string",
            "writeOnly": true,
            "description": "Must equal password."
          }
        }
      },
      "AcademyParticipantUpdate": {
        "type": "object",
        "required": [
          "name",
          "address",
          "phone",
          "gender"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "maxLength": 2000
          },
          "phone": {
            "type": "string",
            "description": "Indonesian mobile number; local 08 prefix is normalized to 628."
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 10,
            "writeOnly": true,
            "description": "Maximum 72 bytes."
          },
          "gender": {
            "type": "string",
            "enum": [
              "IKHWAN",
              "AKHWAT"
            ]
          },
          "cohortId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional cohort change, subject to previous cohort completion rules."
          },
          "courseId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional existing course; if cohort-bound it must belong to the chosen cohort."
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Foundation"
        ],
        "security": [],
        "summary": "Application and database health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Degraded database health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginPlaceholder",
        "tags": [
          "Foundation"
        ],
        "security": [],
        "summary": "Login placeholder; does not issue tokens yet",
        "description": "Explicit POST action exception. Five attempts per minute per normalized email/IP. Returns 501 after valid input.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 191
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Seconds before retry"
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "Not implemented; internal details omitted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/academy/participants": {
      "post": {
        "summary": "Create an Academy participant as an authorized administrator.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcademyParticipantCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Participant account and profile created atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "userId",
                        "nip"
                      ],
                      "properties": {
                        "userId": {
                          "type": "string"
                        },
                        "nip": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request rejected (401)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected (403)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected (404)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected (409)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request rejected (422)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request rejected (429)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/academy/register": {
      "post": {
        "summary": "Register in the currently open Academy cohort.",
        "description": "The server selects the open cohort and ignores caller-provided cohortId and courseId. Returns 409 when registration closes; no program is required.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcademyPublicRegistration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Participant account and profile created atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "userId",
                        "nip"
                      ],
                      "properties": {
                        "userId": {
                          "type": "string"
                        },
                        "nip": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request rejected (401)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected (403)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected (404)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected (409)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request rejected (422)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request rejected (429)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/academy/participants/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Participant profile ID."
        }
      ],
      "put": {
        "summary": "Update an Academy participant as an authorized administrator.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcademyParticipantUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "const": true
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Request rejected (401)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected (403)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected (404)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected (409)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request rejected (422)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request rejected (429)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "Siperp API",
    "version": "1.0.0",
    "description": "Partial API contract. Includes Core foundation and Academy participant registration; other runtime endpoints are defined by their module routes and tests."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sanctum personal access token; absolute lifetime seven days. No session cookies."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "degraded"
                ]
              },
              "database": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "connected",
                      "unavailable"
                    ]
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "status",
              "database"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "PaymentAttempt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[a-z0-9]{24}$"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "pending",
              "cancelled"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "amount",
          "status"
        ],
        "additionalProperties": false
      },
      "PaymentAttemptResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PaymentAttempt"
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "PaymentAttemptCollection": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentAttempt"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer",
                "maximum": 100
              },
              "total": {
                "type": "integer"
              },
              "last_page": {
                "type": "integer"
              },
              "from": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "to": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "path": {
                "type": "string"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "label": {
                      "type": "string"
                    },
                    "active": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "url",
                    "label",
                    "active"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "current_page",
              "per_page",
              "total",
              "last_page",
              "from",
              "to",
              "path",
              "links"
            ],
            "additionalProperties": true
          },
          "links": {
            "type": "object",
            "properties": {
              "first": {
                "type": "string"
              },
              "last": {
                "type": "string"
              },
              "prev": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "first",
              "last",
              "prev",
              "next"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data",
          "meta",
          "links"
        ],
        "additionalProperties": false
      },
      "AcademyParticipantCreate": {
        "type": "object",
        "required": [
          "name",
          "address",
          "phone",
          "password",
          "gender",
          "cohortId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "maxLength": 2000
          },
          "phone": {
            "type": "string",
            "description": "Indonesian mobile number; local 08 prefix is normalized to 628."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "writeOnly": true,
            "description": "Maximum 72 bytes."
          },
          "gender": {
            "type": "string",
            "enum": [
              "IKHWAN",
              "AKHWAT"
            ]
          },
          "cohortId": {
            "type": "string",
            "description": "Existing cohort ID; required for admin creation."
          },
          "courseId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional existing course; if cohort-bound it must belong to the chosen cohort."
          }
        }
      },
      "AcademyPublicRegistration": {
        "type": "object",
        "required": [
          "name",
          "address",
          "phone",
          "password",
          "gender",
          "email",
          "confirmPassword"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "maxLength": 2000
          },
          "phone": {
            "type": "string",
            "description": "Indonesian mobile number; local 08 prefix is normalized to 628."
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "writeOnly": true,
            "description": "Maximum 72 bytes."
          },
          "gender": {
            "type": "string",
            "enum": [
              "IKHWAN",
              "AKHWAT"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 191
          },
          "confirmPassword": {
            "type": "string",
            "writeOnly": true,
            "description": "Must equal password."
          }
        }
      },
      "AcademyParticipantUpdate": {
        "type": "object",
        "required": [
          "name",
          "address",
          "phone",
          "gender"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "maxLength": 2000
          },
          "phone": {
            "type": "string",
            "description": "Indonesian mobile number; local 08 prefix is normalized to 628."
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 10,
            "writeOnly": true,
            "description": "Maximum 72 bytes."
          },
          "gender": {
            "type": "string",
            "enum": [
              "IKHWAN",
              "AKHWAT"
            ]
          },
          "cohortId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional cohort change, subject to previous cohort completion rules."
          },
          "courseId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional existing course; if cohort-bound it must belong to the chosen cohort."
          }
        }
      },
      "SarsipProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "headline",
          "description",
          "contact",
          "heroImage"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "contact": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 191
          },
          "heroImage": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 191,
            "pattern": "^/uploads/sarsip/[a-fA-F0-9-]{36}\\.(?:jpg|png|webp)$",
            "description": "Image URL returned by the authenticated SARSIP upload endpoint. Null uses the built-in illustration. Omission on update preserves the saved photo for older clients."
          }
        }
      },
      "SarsipProfileUpdate": {
        "type": "object",
        "required": [
          "headline",
          "description"
        ],
        "properties": {
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "contact": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 191
          },
          "heroImage": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 191,
            "pattern": "^/uploads/sarsip/[a-fA-F0-9-]{36}\\.(?:jpg|png|webp)$",
            "description": "Image URL returned by the authenticated SARSIP upload endpoint. Null uses the built-in illustration. Omission on update preserves the saved photo for older clients."
          }
        }
      },
      "BantuanMobileLogin": {
        "type": "object",
        "required": [
          "code",
          "password"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,31}$",
            "description": "Existing ERP account code; outer whitespace is trimmed and lookup is case-insensitive."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true
          }
        }
      },
      "BantuanMobileToken": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "token",
              "expires_at"
            ],
            "additionalProperties": false,
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "SantunanInput": {
        "type": "object",
        "required": [
          "frequency",
          "category",
          "period",
          "recipientName",
          "volunteerId",
          "amount"
        ],
        "properties": {
          "frequency": {
            "type": "string",
            "enum": [
              "routine",
              "non_routine"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "widow",
              "orphan",
              "foster_child",
              "tahfidz"
            ]
          },
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "recipientName": {
            "type": "string",
            "maxLength": 191
          },
          "volunteerId": {
            "type": "string",
            "maxLength": 191
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9000000000000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "frequency": {
                  "const": "non_routine"
                }
              }
            },
            "then": {
              "properties": {
                "category": {
                  "const": "orphan"
                }
              }
            }
          }
        ]
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Foundation"
        ],
        "security": [],
        "summary": "Application and database health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Degraded database health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginWithAccountCode",
        "tags": [
          "Foundation"
        ],
        "security": [],
        "summary": "Login with account code and password",
        "description": "Issues an HttpOnly Sanctum session cookie. Five attempts per minute per normalized code/IP. Email login is not supported.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 32,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,31}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 72
                  }
                },
                "required": [
                  "code",
                  "password"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated; data contains userId, name, code, isSuperadmin, moduleSlugs and moduleRoles. Set-Cookie issues the HttpOnly session."
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Incorrect account code or password, or inactive account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Seconds before retry"
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/academy/participants": {
      "post": {
        "summary": "Create an Academy participant as an authorized administrator.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcademyParticipantCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Participant account and profile created atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "userId",
                        "nip"
                      ],
                      "properties": {
                        "userId": {
                          "type": "string"
                        },
                        "nip": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request rejected (401)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected (403)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected (404)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected (409)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request rejected (422)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request rejected (429)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/academy/register": {
      "post": {
        "summary": "Register in the currently open Academy cohort.",
        "description": "The server selects the open cohort and ignores caller-provided cohortId and courseId. Returns 409 when registration closes; no program is required.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcademyPublicRegistration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Participant account and profile created atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "userId",
                        "nip"
                      ],
                      "properties": {
                        "userId": {
                          "type": "string"
                        },
                        "nip": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request rejected (401)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected (403)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected (404)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected (409)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request rejected (422)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request rejected (429)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/academy/participants/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Participant profile ID."
        }
      ],
      "put": {
        "summary": "Update an Academy participant as an authorized administrator.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcademyParticipantUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "const": true
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Request rejected (401)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected (403)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected (404)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected (409)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Request rejected (422)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request rejected (429)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sarsip/profile": {
      "get": {
        "summary": "Read public SARSIP profile and hero image",
        "security": [],
        "responses": {
          "200": {
            "description": "Public profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SarsipProfile"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save SARSIP profile and optional hero image",
        "description": "Requires an active user with SARSIP access. Older clients may omit heroImage to keep the current photo; send null to return to the built-in illustration.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
